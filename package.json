{
  "name": "auction-site-starter",
  "version": "0.1.0",
  "private": true,
  "description": "An auction house's buyer and seller site on the Doubleslash Auctions API (/api/v1). Fork it, theme it, host it anywhere.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript openapi/auctions-v1.json -o src/lib/schema.d.ts",
    "check:api": "openapi-typescript openapi/auctions-v1.json -o src/lib/schema.d.ts && git diff --exit-code -- src/lib/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
