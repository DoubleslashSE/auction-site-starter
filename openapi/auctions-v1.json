{
  "openapi": "3.1.1",
  "info": {
    "title": "Doubleslash Auctions API",
    "description": "For auction houses' own sites. Sign Users in with OpenID Connect (code flow with PKCE) at the house's realm and send the access token as a bearer token; send `X-Tenant: <house>` on every call. Commands return 202/204 with no body; errors are RFC 9457 problem details. Guide: docs/headless-api.md.",
    "version": "1"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
