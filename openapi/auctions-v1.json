      "get": {
        "tags": [
          "Auctions API v1"
        ],
        "operationId": "V1GetHouse",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HouseDto"
                }
              }
            }
          }
        }
      }
    },
